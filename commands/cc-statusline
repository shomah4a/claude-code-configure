#!/usr/bin/env python3
"""
Claude Code statusLine コマンド

stdin で渡される statusLine JSON を読み取り、以下のテンプレートに従った
2 行のステータス文字列を stdout へ出力する。

  line 1 (claude code status):
    model: <model_name> (<model_id>) context: <percent>% usage: <usage_5h>% (until <HH:MM>)
  line 2 (environ):
    repository: <repo_name> worktree: <worktree> branch: <branch> (<commit_hash>)

各値の補足:
- usage セグメントの (until HH:MM) は 5 時間レート制限のリセット時刻（Asia/Tokyo 固定）。
- worktree はデフォルト（メイン）作業ツリーでは "(root)"、リンク worktree では
  "<worktree_name> (<relpath>)"（worktree ルートの basename とメインリポジトリ
  ルートからの相対パス）。
- branch は現在ブランチ名、(commit_hash) は HEAD の short hash（detached 時は branch が None）。
- 値が取得できない項目は省略せず "None" を表示する。

JSON スキーマ: https://code.claude.com/docs/en/statusline.md

設計方針:
- 出力文字列の組み立ては純粋関数 build_status_line に集約し、
  副作用（stdin 読込・git subprocess）は main 側へ外部化する。
- git 情報（ブランチ・コミット・worktree パス）は JSON に常設フィールドが無いため
  subprocess で取得する。現在ブランチを常に与える JSON フィールドは存在せず
  （worktree.branch は --worktree セッション限定で hook ベースでは absent）、
  取得元を git subprocess 一本に統一する。
- 表示スタイル（背景色・文字色）は ANSI エスケープシーケンスで付与する。
  端末は印字文字にのみ背景色を乗せるため、行全体の横幅フルには塗らない。
  複数行は行ごとに背景色を開始・RESET し、行間で背景が崩れないようにする。
"""

import json
import os
import re
import subprocess
import sys
from collections import namedtuple
from datetime import datetime, timedelta, timezone

# git subprocess のハング防止のための上限。statusLine は描画ごとに実行されるため短く保つ。
GIT_TIMEOUT_SEC = 2

# リセット時刻の表示タイムゾーン。日本標準時は夏時間が無いため固定オフセット +9 時間で
# 正確に表現でき、tzdata（zoneinfo）の有無に依存しない。
JST = timezone(timedelta(hours=9))

# 値が取得できなかった項目の表示。省略すると値欠損とバグの区別が付かないため、
# 欠損を明示するために全項目で共通してこのラベルを表示する。
NONE_LABEL = "None"

# デフォルト（メイン）作業ツリーのときの worktree 表示ラベル。
# 相対パスは "." になるが、視認性のため "(root)" と表示する。
DEFAULT_WORKTREE_LABEL = "root"

# git subprocess から得た環境情報。interface 境界では immutable な構造のみを渡す。
GitInfo = namedtuple(
    "GitInfo",
    ["repo_name", "worktree_name", "worktree_relpath", "is_default_worktree", "branch", "commit_hash"],
)

# ANSI エスケープシーケンス（表示スタイル）
RESET = "\033[0m"
BG_LIGHT_GRAY = "\033[48;5;250m"  # 明るめの灰色背景（256 色: 250）
FG_BASE = "\033[38;5;238m"  # 基本文字色: 暗めの灰色（256 色: 238）
# context の閾値色。明るい背景でも読めるよう濃いめの緑/黄/赤を用いる。
FG_GREEN = "\033[38;5;28m"
FG_YELLOW = "\033[38;5;136m"
FG_RED = "\033[38;5;160m"

# 使用率の色分け閾値（%）。この値以下なら該当色を用いる。context / usage 共通。
GREEN_MAX_PERCENT = 50
YELLOW_MAX_PERCENT = 75

# Claude Code は statusLine 行の左右に各 2 文字のマージンを設けるため、
# 実効表示幅は COLUMNS からこの値を引いたものとする。
STATUSLINE_MARGIN_COLUMNS = 4

# SGR 色コード（\033[...m）を取り除いて表示幅を測るためのパターン。
_SGR_PATTERN = re.compile(r"\033\[[0-9;]*m")


def visible_length(text):
    """SGR エスケープを除いた表示文字数を返す。

    内容は ASCII（モデル名・id・リポジトリ名・ブランチ名・パス）想定のため、
    文字数 = 端末カラム数として扱う。マルチバイトを含むパスでは幅がずれうるが、
    両端揃えの間隔計算が崩れるだけで表示自体は壊れない。
    """
    return len(_SGR_PATTERN.sub("", text))


def percent_color(percent):
    """使用率に応じた文字色エスケープを返す（context / usage 共用）。

    閾値: <=50% 緑 / <=75% 黄 / それ以上 赤。
    """
    if percent <= GREEN_MAX_PERCENT:
        return FG_GREEN
    if percent <= YELLOW_MAX_PERCENT:
        return FG_YELLOW
    return FG_RED


def display_text(value):
    """空・None の文字列値を NONE_LABEL へ畳む。値があればそのまま返す。"""
    return value if value else NONE_LABEL


def render_percent(percent):
    """使用率を色付きの "<n>%" へ整形する。None（欠損）のときは NONE_LABEL を返す。"""
    if percent is None:
        return NONE_LABEL
    return f"{percent_color(percent)}{percent}%{FG_BASE}"


def format_reset_time(resets_at):
    """レート制限リセット時刻（Unix epoch 秒）を Asia/Tokyo の "(until HH:MM)" へ整形する。

    resets_at が None（リセット時刻不明）・非数値のときは "(until None)" を返す。
    省略すると値欠損とバグの区別が付かないため、欠損を明示する。
    """
    if resets_at is None:
        return "(until None)"
    try:
        epoch_sec = int(resets_at)
    except (TypeError, ValueError):
        return "(until None)"
    reset_dt = datetime.fromtimestamp(epoch_sec, tz=JST)
    return reset_dt.strftime("(until %H:%M)")


def distribute_segments(segments, columns):
    """セグメント列を 1 行の本文へ連結する。

    columns（端末カラム数）に余裕がある（単一スペース連結より広い）ときは、
    セグメント間のスペースを均等配分する両端揃え（先頭は左端、末尾は右端、
    間隔は均等。端数は先頭側の間隔へ寄せる）を行う。
    余裕が無い / columns 不明のときは単一スペース連結し、columns が正なら
    末尾をスペースで埋める。
    """
    joined_single = " ".join(segments)
    gaps = len(segments) - 1
    single_visible = visible_length(joined_single)

    if columns <= 0 or gaps <= 0 or columns <= single_visible:
        padding = " " * max(0, columns - single_visible) if columns > 0 else ""
        return joined_single + padding

    content_visible = sum(visible_length(seg) for seg in segments)
    extra = columns - content_visible
    base_gap, remainder = divmod(extra, gaps)

    pieces = [segments[0]]
    for index in range(1, len(segments)):
        gap = base_gap + (1 if index <= remainder else 0)
        pieces.append(" " * gap)
        pieces.append(segments[index])
    return "".join(pieces)


def style_line(body):
    """1 行の本文を背景色・基本文字色で囲み、行末で RESET する。

    複数行では各行を個別に囲むことで、行間（改行）で背景色が引き継がれて
    崩れるのを防ぐ。
    """
    return f"{BG_LIGHT_GRAY}{FG_BASE}{body}{RESET}"


def build_status_line(model_name, model_id, context_fill_percent, usage_5h_percent, usage_5h_resets_at, git_info, columns):
    """ステータス行（2 行）を組み立てる純粋関数。

    背景を明るい灰色、基本文字色を暗い灰色にし、context / usage 使用率を閾値で
    色分けする。各ラベルは "label: value" 形式（コロンの後にスペース）で揃える。
    1 行目は Claude Code のセッション状態、2 行目はリポジトリ環境を表す。
    値が取得できない項目は省略せず NONE_LABEL を表示し、値欠損とバグを区別可能にする。
    usage セグメントには % の後にリセット時刻 "(until HH:MM)"（Asia/Tokyo）を付加する。
    各行は columns（端末カラム数）に余裕があるときセグメント間を均等割り付けし、
    背景を端末幅いっぱいに広げる（distribute_segments 参照）。
    """
    status_segments = [
        f"model: {display_text(model_name)} ({display_text(model_id)})",
        # render_percent は色付け後に基本文字色(FG_BASE)へ戻す（背景は維持される）。
        f"context: {render_percent(context_fill_percent)}",
        f"usage: {render_percent(usage_5h_percent)} {format_reset_time(usage_5h_resets_at)}",
    ]
    if git_info.is_default_worktree:
        worktree_segment = f"worktree: ({DEFAULT_WORKTREE_LABEL})"
    else:
        worktree_segment = f"worktree: {display_text(git_info.worktree_name)} ({display_text(git_info.worktree_relpath)})"

    environ_segments = [
        f"repository: {display_text(git_info.repo_name)}",
        worktree_segment,
        f"branch: {display_text(git_info.branch)} ({display_text(git_info.commit_hash)})",
    ]

    lines = [
        style_line(distribute_segments(status_segments, columns)),
        style_line(distribute_segments(environ_segments, columns)),
    ]
    return "\n".join(lines)


def _run_git(args, cwd):
    """git コマンドを実行し標準出力を返す。

    git 不在・git 外ディレクトリ・タイムアウトは statusLine では通常起こりうる状態のため、
    例外を送出せず空文字へフォールバックする（表示が空になるだけで害がない）。
    """
    try:
        result = subprocess.run(
            ["git", *args],
            cwd=cwd,
            capture_output=True,
            text=True,
            timeout=GIT_TIMEOUT_SEC,
        )
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return ""
    if result.returncode != 0:
        return ""
    return result.stdout.strip()


def collect_git_info(cwd):
    """cwd を起点に git 環境情報（GitInfo）を取得する。

    取得できない項目（git 不在・git 外・空リポジトリ・detached HEAD など）は
    空文字のままとし、表示層で NONE_LABEL へ畳む。
    - repo_name: メインリポジトリルートの basename
    - worktree_name: 現在 worktree ルートの basename
    - worktree_relpath: メインリポジトリルートからの相対パス（デフォルト作業ツリーは "."）
    - is_default_worktree: 現在地がデフォルト（メイン）作業ツリーかどうか
    - branch: 現在ブランチ名（detached HEAD では空）
    - commit_hash: HEAD の short hash（空リポジトリでは空）
    """
    common_dir = _run_git(["rev-parse", "--path-format=absolute", "--git-common-dir"], cwd)
    toplevel = _run_git(["rev-parse", "--show-toplevel"], cwd)
    branch = _run_git(["branch", "--show-current"], cwd)
    commit_hash = _run_git(["rev-parse", "--short", "HEAD"], cwd)

    # --git-common-dir はメインの .git を指すため、その親がメインリポジトリルート。
    main_root = os.path.dirname(common_dir) if common_dir else ""
    repo_name = os.path.basename(main_root) if main_root else ""

    if main_root and toplevel:
        worktree_name = os.path.basename(toplevel)
        worktree_relpath = os.path.relpath(toplevel, main_root)
        # 相対パスが "." ならデフォルト（メイン）作業ツリー。
        is_default_worktree = worktree_relpath == "."
    else:
        worktree_name = ""
        worktree_relpath = ""
        is_default_worktree = False

    return GitInfo(
        repo_name=repo_name,
        worktree_name=worktree_name,
        worktree_relpath=worktree_relpath,
        is_default_worktree=is_default_worktree,
        branch=branch,
        commit_hash=commit_hash,
    )


def collect_status(data):
    """JSON データから純粋関数への入力を組み立てる（副作用を含む層）。"""
    model = data.get("model", {})
    model_name = model.get("display_name", "")
    model_id = model.get("id", "")

    # null（セッション初期 / compact 直後）・キー不在は None とし、0% への畳み込みは
    # 行わない（「使用率 0」と値欠損が区別できなくなるため）。
    context_window = data.get("context_window", {}) or {}
    raw_context = context_window.get("used_percentage")
    context_fill_percent = int(raw_context) if raw_context is not None else None

    # 5 時間レート制限の使用率。非対象プラン / 初回 API 応答前は欠損するため、
    # null・キー不在は None とする（usage セグメントでは NONE_LABEL を表示し、
    # 0% への畳み込みは「使用率 0」と誤読されるため行わない）。
    rate_limits = data.get("rate_limits", {}) or {}
    five_hour = rate_limits.get("five_hour", {}) or {}
    raw_usage_5h = five_hour.get("used_percentage")
    usage_5h_percent = int(raw_usage_5h) if raw_usage_5h is not None else None

    # リセット時刻（Unix epoch 秒）。欠損時は None とし "(until None)" を表示する。
    usage_5h_resets_at = five_hour.get("resets_at")

    workspace = data.get("workspace", {})
    # git subprocess の cwd は保証されないため、JSON から作業ディレクトリを明示注入する。
    cwd = workspace.get("current_dir") or data.get("cwd") or os.getcwd()
    git_info = collect_git_info(cwd)

    # 端末幅は stdout からは取得できず、Claude Code が COLUMNS 環境変数を
    # 実行前に設定する（v2.1.153 以降）。未設定・不正値は 0（埋めない）に畳む。
    terminal_columns = _parse_columns(os.environ.get("COLUMNS"))
    # 左右マージン分を差し引いた実効幅で割り付ける。
    columns = max(0, terminal_columns - STATUSLINE_MARGIN_COLUMNS) if terminal_columns > 0 else 0

    return build_status_line(
        model_name=model_name,
        model_id=model_id,
        context_fill_percent=context_fill_percent,
        usage_5h_percent=usage_5h_percent,
        usage_5h_resets_at=usage_5h_resets_at,
        git_info=git_info,
        columns=columns,
    )


def _parse_columns(raw):
    """COLUMNS 環境変数を非負整数へ変換する。不明・不正値は 0 を返す。"""
    if not raw:
        return 0
    try:
        value = int(raw)
    except ValueError:
        return 0
    return value if value > 0 else 0


def main():
    raw = sys.stdin.read()
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        # 入力が JSON でない場合は表示するものが無いため空行を出して終了する。
        print("")
        return
    print(collect_status(data))


if __name__ == "__main__":
    main()
