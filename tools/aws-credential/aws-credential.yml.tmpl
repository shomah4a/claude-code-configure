# aws-credential MCP サーバーの取得元設定
#
# このファイルを aws-credential.yml にコピーして編集してください (aws-credential.yml は git 管理外)。
#   cp aws-credential.yml.tmpl aws-credential.yml
#
# credentials 配下のキーが MCP ツール aws_get_credentials の name 引数になります。
# profile はホスト側 ~/.aws/config に定義されたプロファイル名です。
# name / profile はいずれも英数字で始まり、英数字と . _ - のみで構成してください。
credentials:
  dev:
    profile: my-dev-profile
  # staging:
  #   profile: my-staging-profile
